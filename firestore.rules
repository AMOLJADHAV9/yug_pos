rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // --- ROBUST HELPERS ---
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Safely fetch user metadata
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }
    
    function getRestaurantId() {
      let data = getUserData();
      return data != null ? data.get('restaurantId', 'none') : 'none';
    }

    // Tenant check: verifies if a document belongs to the user's restaurant
    function isOwner(data) {
      let rid = getRestaurantId();
      return rid != 'none' && data != null && data.get('restaurantId', '') == rid;
    }

    function hasRole(roles) {
      let r = getUserData().get('role', 'none');
      return r in roles;
    }

    // ==========================================
    // --- CORE COLLECTIONS ---
    // ==========================================

    match /users/{userId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == userId || 
        hasRole(['admin', 'Admin'])
      );
    }

    match /restaurants/{resId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && hasRole(['admin', 'Admin']);
    }

    match /settings/{resId} {
      allow read, write: if isSignedIn() && (resId == getRestaurantId() || hasRole(['admin', 'Admin']));
    }

    // ==========================================
    // --- OPERATIONAL DATA (STAFF PERMISSIONS) ---
    // ==========================================

    match /tables/{tableId} {
      allow read: if isSignedIn() && (resource == null || isOwner(resource.data));
      allow write: if isSignedIn() && (resource == null || isOwner(resource.data)) && 
                    (request.resource == null || isOwner(request.resource.data));
    }

    match /menu_categories/{catId} {
      allow read: if isSignedIn() && (resource == null || isOwner(resource.data));
      allow write: if isSignedIn() && hasRole(['admin', 'Admin']);
    }
    match /menu_items/{itemId} {
      allow read: if isSignedIn() && (resource == null || isOwner(resource.data));
      allow write: if isSignedIn() && hasRole(['admin', 'Admin']);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource == null || isOwner(resource.data));
      allow create: if isSignedIn() && isOwner(request.resource.data);
      allow update: if isSignedIn() && isOwner(resource.data) && (
        hasRole(['admin', 'Admin', 'cashier', 'Cashier']) || 
        (hasRole(['waiter', 'Waiter']) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['preparing', 'ready']))
      );
      allow delete: if isSignedIn() && hasRole(['admin', 'Admin', 'cashier', 'Cashier']);
      
      match /items/{itemId} {
        allow read, write: if isSignedIn();
      }
    }

    match /kots/{kotId} {
      allow read, create: if isSignedIn() && (request.resource == null || isOwner(request.resource.data));
      allow update, delete: if isSignedIn() && isOwner(resource.data);
    }

    // Monthly/Daily Financial Records
    match /daily_collections/{docId} {
      // Replaced invalid startsWith with explicit owner and prefix checks
      allow read, write: if isSignedIn() && (
        isOwner(resource.data) || 
        (request.resource != null && isOwner(request.resource.data)) ||
        docId.matches('^' + getRestaurantId() + '_.*')
      );
    }
    
    match /receipt_counters/{resId} {
      allow read, write: if isSignedIn() && (resId == getRestaurantId() || isOwner(resource.data));
    }
  }
}
